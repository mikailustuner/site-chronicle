NODE_ENV=production
PORT=43180
HOST=0.0.0.0
DATABASE_URL=postgres://sitechronicle:change-me@postgres:5432/sitechronicle
ARTIFACTS_PATH=/data/artifacts
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_BASE_URL=https://audit.example.com
SITECHRONICLE_HOST=audit.example.com
# Leave empty to use Playwright's bundled Chromium.
CHROME_PATH=
WORKER_ID=worker-1
WORKER_CONCURRENCY=1
ALLOW_PRIVATE_TARGETS=false
REQUIRE_DOMAIN_VERIFICATION=false
RETENTION_DAYS=90
# The compose defaults expose this only to the isolated ZAP control network.
AUDIT_PROXY_BIND_HOST=127.0.0.1
AUDIT_PROXY_PORT=0
AUDIT_PROXY_ADVERTISE_HOST=127.0.0.1
# Supported values: none, openai-compatible, anthropic-compatible
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
