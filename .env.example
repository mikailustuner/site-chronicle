# SiteChronicle test/home-server configuration
NODE_ENV=production
PORT=43180
HOST=0.0.0.0

# PostgreSQL
POSTGRES_PASSWORD=6f00d3089bcf63b797c7b79aebe036d2475282146ac0e3de
DATABASE_URL=postgres://sitechronicle:6f00d3089bcf63b797c7b79aebe036d2475282146ac0e3de@postgres:5432/sitechronicle

# Storage and API authentication
ARTIFACTS_PATH=/data/artifacts
ADMIN_PASSWORD=fa982d8481cfd4224d7f2a7a89312f25
SESSION_SECRET=194462182c36c16ee6ad6e0255ad7f4e397dba3fad04906b3a2b513f8e1ed24c
CONNECTOR_MASTER_KEY=bd8aa8ce3e147a318b9f683469d4d5e80d0af68044d81cb7045e604432c8e675

# Private home-server/Tailscale access
PUBLIC_BASE_URL=http://100.104.207.55:43180
TRUST_PRIVATE_HTTP=true
SITECHRONICLE_BIND_IP=0.0.0.0
SITECHRONICLE_PORT=43180
SITECHRONICLE_HOST=localhost

# Application internals
WEB_DIST_PATH=../../web/dist
LOG_LEVEL=info
# Empty uses the Chromium bundled in the Playwright image.
CHROME_PATH=

# Worker
RETENTION_DAYS=90
WORKER_ID=worker-1
WORKER_CONCURRENCY=1
POLL_INTERVAL_MS=1500
ALLOW_PRIVATE_TARGETS=false
REQUIRE_DOMAIN_VERIFICATION=false

# The worker receives compose-network values for these three settings.
AUDIT_PROXY_BIND_HOST=0.0.0.0
AUDIT_PROXY_PORT=43182
AUDIT_PROXY_ADVERTISE_HOST=worker

# Optional public CrUX data. Leave empty when no Google API key is available.
CRUX_API_KEY=

# Optional OWASP ZAP security profile.
# Start it with: docker compose --profile security up -d
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=b95a882c75aefc50dd66e293ad26b3c652858099f548164e

# OpenCode Go / Anthropic-compatible AI
AI_PROVIDER=anthropic-compatible
